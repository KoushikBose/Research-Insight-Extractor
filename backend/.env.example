# Copy to .env and fill in. Without GROQ_API_KEY the app runs in "extractive" (offline) mode.
GROQ_API_KEY=
# Primary model (Groq). The LiteLLM gateway falls back to LLM_FALLBACK_MODEL (below) on any failure.
GROQ_MODEL=qwen/qwen3.8-27b
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
CORS_ORIGINS=http://localhost:5173

# LangSmith tracing (https://smith.langchain.com) - paste your key; tracing turns on automatically
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=research-insight-extractor
# LANGSMITH_HIDE_INPUTS=true

# --- LiteLLM gateway: primary -> fallback (LiteLLM "provider/model" ids) ---
# LLM_PRIMARY_MODEL=groq/qwen/qwen3.8-27b   # default: groq/$GROQ_MODEL
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-120b
LLM_FAIL_THRESHOLD=2        # consecutive primary failures before the circuit opens
LLM_COOLDOWN_SECONDS=300    # how long the primary is skipped once the circuit is open
# LITELLM_PROXY_URL=http://localhost:4000   # optional standalone proxy, see litellm_config.yaml
